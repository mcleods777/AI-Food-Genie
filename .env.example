# Vercel Postgres — these are auto-filled when you add a Postgres store in Vercel
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# AI Providers (optional — app works with mock data if none are set)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
