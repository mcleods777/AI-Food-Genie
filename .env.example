DATABASE_URL="file:./dev.db"

# AI Providers (configure at least one for AI features, app works with mock data otherwise)
# The system automatically routes tasks to the best available provider:
#   - Gemini Flash: primary scanner (cheapest, fastest, bounding boxes)
#   - Claude: expiration date OCR (lowest hallucination rate for food safety dates)
#   - GPT-4o: fallback for all tasks

GEMINI_API_KEY="your-gemini-api-key-here"
CLAUDE_API_KEY="your-claude-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
