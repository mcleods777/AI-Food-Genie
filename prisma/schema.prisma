generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Pantry/inventory items detected from photos or manually added
model PantryItem {
  id            String    @id @default(uuid())
  name          String
  category      String    @default("Other") // Produce, Dairy, Meat, Grain, Spice, Canned, Frozen, Beverage, Snack, Other
  quantity      Float     @default(1)
  unit          String    @default("item") // item, lb, oz, gal, ct, bag, box, can, bottle
  location      String    @default("Pantry") // Pantry, Refrigerator, Freezer, Cabinet
  expirationDate DateTime?
  expiryEstimateReason String? @db.Text // why this expiration was estimated
  opened        Boolean   @default(false) // whether the item has been opened/unsealed
  purchaseDate  DateTime?
  imageUrl      String?
  notes         String?   @db.Text
  needsRestock  Boolean   @default(false)
  barcode       String?   // barcode string from scan
  brand         String?   // product brand from Open Food Facts
  ingredients   String?   @db.Text // full ingredients list
  nutriScore    String?   // Nutri-Score grade (a-e)
  novaGroup     Int?      // NOVA food processing group (1-4)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

// Recipes - either manually added or extracted from URLs
model Recipe {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  sourceUrl    String?
  servings     Int      @default(4)
  prepTime     Int?     // minutes
  cookTime     Int?     // minutes
  instructions String?  @db.Text // stored as JSON array of steps
  imageUrl     String?
  tags         String?  // comma-separated tags
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients RecipeIngredient[]
  mealPlans   MealPlanEntry[]
}

// Ingredients needed for a recipe
model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  pantryItemId String?
  name         String
  quantity     Float   @default(1)
  unit         String  @default("item")
  optional     Boolean @default(false)

  recipe     Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  pantryItem PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
}

// Weekly meal plan
model MealPlanEntry {
  id        String   @id @default(uuid())
  date      DateTime
  mealType  String   // Breakfast, Lunch, Dinner, Snack
  recipeId  String?
  customMeal String? // for meals not tied to a recipe
  servings  Int      @default(2)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

// Household configuration for meal planning
model HouseholdConfig {
  id        String  @id @default(uuid())
  name      String  @default("Default")
  scenario  String  // "solo", "with_kids", "with_partner", "with_partner_and_kids", "special_occasion"
  headcount Int     @default(1)
  notes     String? @db.Text
  isDefault Boolean @default(false)
}

// Shopping list
model ShoppingListItem {
  id           String  @id @default(uuid())
  name         String
  quantity     Float   @default(1)
  unit         String  @default("item")
  category     String  @default("Other")
  checked      Boolean @default(false)
  pantryItemId String?
  notes        String? @db.Text
  createdAt    DateTime @default(now())

  pantryItem PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
}

// Audit log for inventory checks
model AuditLog {
  id        String   @id @default(uuid())
  type      String   // "full_audit", "expiration_check", "restock_check"
  summary   String?  @db.Text
  details   String?  @db.Text // JSON with audit findings
  createdAt DateTime @default(now())
}
