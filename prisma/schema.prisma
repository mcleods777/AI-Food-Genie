generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

// Pantry/inventory items detected from photos or manually added
model PantryItem {
  id            String    @id @default(uuid())
  name          String
  category      String    @default("Other") // Produce, Dairy, Meat, Grain, Spice, Canned, Frozen, Beverage, Snack, Other
  quantity      Float     @default(1)
  unit          String    @default("item") // item, lb, oz, gal, ct, bag, box, can, bottle
  location      String    @default("Pantry") // Pantry, Refrigerator, Freezer, Cabinet
  expirationDate DateTime?
  expiryEstimateReason String? @db.Text // why this expiration was estimated
  opened        Boolean   @default(false) // whether the item has been opened/unsealed
  purchaseDate  DateTime?
  imageUrl      String?
  notes         String?   @db.Text
  needsRestock  Boolean   @default(false)
  barcode       String?   // barcode string from scan
  brand         String?   // product brand from Open Food Facts
  ingredients   String?   @db.Text // full ingredients list
  nutriScore    String?   // Nutri-Score grade (a-e)
  novaGroup     Int?      // NOVA food processing group (1-4)
  urgencyNotifiedAt DateTime? // last time user was notified this item is expiring
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  recipeIngredients RecipeIngredient[]
  shoppingListItems ShoppingListItem[]
}

// Recipes - either manually added or extracted from URLs
model Recipe {
  id           String   @id @default(uuid())
  title        String
  description  String?  @db.Text
  sourceUrl    String?
  servings     Int      @default(4)
  prepTime     Int?     // minutes
  cookTime     Int?     // minutes
  instructions String?  @db.Text // stored as JSON array of steps
  imageUrl     String?
  tags         String?  // comma-separated tags
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients RecipeIngredient[]
  mealPlans   MealPlanEntry[]
}

// Ingredients needed for a recipe
model RecipeIngredient {
  id           String  @id @default(uuid())
  recipeId     String
  pantryItemId String?
  name         String
  quantity     Float   @default(1)
  unit         String  @default("item")
  optional     Boolean @default(false)

  recipe     Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  pantryItem PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
}

// Weekly meal plan
model MealPlanEntry {
  id        String   @id @default(uuid())
  date      DateTime
  mealType  String   // Breakfast, Lunch, Dinner, Snack
  recipeId  String?
  customMeal String? // for meals not tied to a recipe
  servings  Int      @default(2)
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)
}

// Household configuration for meal planning
model HouseholdConfig {
  id        String  @id @default(uuid())
  name      String  @default("Default")
  scenario  String  // "solo", "with_kids", "with_partner", "with_partner_and_kids", "special_occasion"
  headcount Int     @default(1)
  notes     String? @db.Text
  isDefault Boolean @default(false)
}

// Shopping list
model ShoppingListItem {
  id           String  @id @default(uuid())
  name         String
  quantity     Float   @default(1)
  unit         String  @default("item")
  category     String  @default("Other")
  checked      Boolean @default(false)
  pantryItemId String?
  notes        String? @db.Text
  createdAt    DateTime @default(now())

  pantryItem PantryItem? @relation(fields: [pantryItemId], references: [id], onDelete: SetNull)
}

// Audit log for inventory checks
model AuditLog {
  id        String   @id @default(uuid())
  type      String   // "full_audit", "expiration_check", "restock_check"
  summary   String?  @db.Text
  details   String?  @db.Text // JSON with audit findings
  createdAt DateTime @default(now())
}

// Daily meal assignment — the core autopilot entity
model DailyAssignment {
  id            String    @id @default(uuid())
  date          DateTime  @db.Date
  mealName      String
  ingredients   Json      // [{name, fromPantry, expiring}]
  steps         Json      // ["step 1", "step 2", ...]
  prepMinutes   Int       @default(30)
  usesExpiring  String[]
  reason        String?
  status        String    @default("pending") // pending, accepted, skipped, expired
  generatedAt   DateTime  @default(now())
  respondedAt   DateTime?

  responses     AssignmentResponse[]

  @@unique([date])
}

// Track how user responded and via which channel
model AssignmentResponse {
  id            String    @id @default(uuid())
  assignmentId  String
  response      String    // "accept" or "skip"
  channel       String    // "push", "sms", "app"
  createdAt     DateTime  @default(now())

  assignment    DailyAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
}

// User notification preferences
model NotificationPreference {
  id            String    @id @default(uuid())
  userId        String    @default("default")
  pushEnabled   Boolean   @default(false)
  smsEnabled    Boolean   @default(false)
  smsPhone      String?
  mealTime      String    @default("16:00")
  checkinTime   String    @default("09:00")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([userId])
}

// Web push subscription storage
model PushSubscription {
  id            String    @id @default(uuid())
  endpoint      String    @unique
  keysP256dh    String
  keysAuth      String
  createdAt     DateTime  @default(now())
}
